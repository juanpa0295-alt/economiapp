{
  "macroeconomia_1": {
    "pib_gasto": {
      "nombre": "PIB - Enfoque del Gasto (Modelo Keynesiano)",
      "formula_general": "Y = \\frac{1}{1 - c_1} \\cdot [C_0 - c_1 T + I + G]",
      "variables": {
        "C0": {"nombre": "Consumo Autónomo", "valor_defecto": 500.0, "ayuda_real": "Consumo de supervivencia financiado con desahorro."},
        "c1": {"nombre": "Propensión a Consumir", "valor_defecto": 0.8, "ayuda_real": "Un valor típico oscila entre 0.6 y 0.9."},
        "T": {"nombre": "Impuestos", "valor_defecto": 200.0, "ayuda_real": "Son los impuestos netos (Recaudo - Transferencias)."},
        "I": {"nombre": "Inversión", "valor_defecto": 300.0, "ayuda_real": "Formación Bruta de Capital Fijo (FBCF)."},
        "G": {"nombre": "Gasto Público", "valor_defecto": 400.0, "ayuda_real": "Gasto de Consumo Final del Gobierno."}
      }
    },
    "teoria_consumo": {
      "nombre": "Teoría del Consumo (Función Keynesiana)",
      "formula_general": "C = C_0 + c_1(Y - T)",
      "variables": {
        "C0": {"nombre": "Consumo Autónomo", "valor_defecto": 300.0, "ayuda_real": "Nivel de consumo fijo que no depende de la renta."},
        "c1": {"nombre": "Propensión Marginal a Consumir", "valor_defecto": 0.75, "ayuda_real": "Cuánto aumenta el consumo si el ingreso aumenta en 1."},
        "Y": {"nombre": "Ingreso Total (Renta)", "valor_defecto": 2000.0, "ayuda_real": "Ingreso agregado de la economía."},
        "T": {"nombre": "Impuestos Netos", "valor_defecto": 250.0, "ayuda_real": "Dinero que el Estado recauda de los hogares."}
      }
    },
    "consumo_intertemporal": {
      "nombre": "Consumo Intertemporal (Fisher y Optimización)",
      "formula_general": "C_1 + \\frac{C_2}{1+r} = Y_1 + \\frac{Y_2}{1+r}",
      "variables": {
        "Y1": {"nombre": "Ingreso Presente (Y1)", "valor_defecto": 1000.0, "ayuda_real": "Ingreso en el periodo actual."},
        "Y2": {"nombre": "Ingreso Futuro (Y2)", "valor_defecto": 1100.0, "ayuda_real": "Ingreso esperado para el próximo periodo."},
        "r": {"nombre": "Tasa de Interés Real (r)", "valor_defecto": 0.05, "ayuda_real": "Tasa ajustada por inflación."},
        "alpha": {"nombre": "Preferencia Presente (α)", "valor_defecto": 0.5, "ayuda_real": "Qué tanta utilidad genera consumir hoy."},
        "beta": {"nombre": "Preferencia Futura (β)", "valor_defecto": 0.5, "ayuda_real": "Qué tanta utilidad genera guardar el consumo para mañana."}
      }
    },
    "inversion": {
      "nombre": "Teoría de la Inversión (Enfoque De Gregorio)",
      "formula_general": "K^* = \\alpha \\frac{Y}{r + \\delta} \\quad \\text{y} \\quad I_t = K^* - (1-\\delta)K_{t-1}",
      "variables": {
        "Y": {"nombre": "Producción Esperada (Y)", "valor_defecto": 5000.0, "ayuda_real": "Nivel de producción o demanda esperada."},
        "alpha": {"nombre": "Participación del Capital (α)", "valor_defecto": 0.33, "ayuda_real": "Elasticidad del producto respecto al capital."},
        "r": {"nombre": "Tasa de Interés Real (r)", "valor_defecto": 0.05, "ayuda_real": "Costo financiero de adquirir el capital."},
        "delta": {"nombre": "Tasa de Depreciación (δ)", "valor_defecto": 0.10, "ayuda_real": "Porcentaje del capital que se desgasta."},
        "K_prev": {"nombre": "Capital Inicial (K_t-1)", "valor_defecto": 8000.0, "ayuda_real": "Stock de maquinaria e infraestructura inicial."},
        "VM": {"nombre": "Valor de Mercado (VM)", "valor_defecto": 1200.0, "ayuda_real": "Capitalización bursátil."},
        "CR": {"nombre": "Costo de Reposición (CR)", "valor_defecto": 1000.0, "ayuda_real": "Costo actual de reemplazar el capital."}
      }
    },
    "mercado_dinero": {
      "nombre": "Mercado de Dinero (Equilibrio L-M)",
      "formula_general": "\\frac{M}{P} = kY - hr",
      "variables": {
        "M": {"nombre": "Oferta Monetaria Nominal (M)", "valor_defecto": 2000.0, "ayuda_real": "Cantidad de dinero circulante."},
        "P": {"nombre": "Nivel de Precios (P)", "valor_defecto": 1.0, "ayuda_real": "Índice de Precios al Consumidor (IPC)."},
        "Y": {"nombre": "Ingreso Real (Y)", "valor_defecto": 4000.0, "ayuda_real": "Nivel de actividad económica o PIB real."},
        "k": {"nombre": "Sensibilidad al Ingreso (k)", "valor_defecto": 0.25, "ayuda_real": "Motivo transacción."},
        "h": {"nombre": "Sensibilidad al Interés (h)", "valor_defecto": 800.0, "ayuda_real": "Motivo especulación."}
      }
    },
    "is_lm": {
      "nombre": "Modelo IS-LM (Equilibrio General)",
      "formula_general": "IS: Y = C + I + G \\quad LM: \\frac{M}{P} = L(Y, r)",
      "variables": {
        "C0": {"nombre": "Consumo Autónomo", "valor_defecto": 500.0, "ayuda_real": "Consumo de supervivencia."},
        "c1": {"nombre": "Propensión a Consumir (c1)", "valor_defecto": 0.8, "ayuda_real": "Sensibilidad del consumo al ingreso."},
        "T": {"nombre": "Impuestos", "valor_defecto": 200.0, "ayuda_real": "Recaudación fiscal neta."},
        "I0": {"nombre": "Inversión Autónoma", "valor_defecto": 800.0, "ayuda_real": "Inversión base empresarial."},
        "b": {"nombre": "Sensibilidad Inversión (b)", "valor_defecto": 2000.0, "ayuda_real": "Respuesta de la inversión a la tasa de interés."},
        "G": {"nombre": "Gasto Público", "valor_defecto": 400.0, "ayuda_real": "Gasto de consumo e inversión del gobierno."},
        "M": {"nombre": "Oferta Monetaria Nominal (M)", "valor_defecto": 2000.0, "ayuda_real": "Dinero en circulación."},
        "P": {"nombre": "Nivel de Precios (P)", "valor_defecto": 1.0, "ayuda_real": "Índice de precios (IPC)."},
        "k": {"nombre": "Sensibilidad Demanda Dinero (k)", "valor_defecto": 0.25, "ayuda_real": "Demanda por motivo transacción."},
        "h": {"nombre": "Sensibilidad Demanda Dinero (h)", "valor_defecto": 800.0, "ayuda_real": "Demanda por motivo especulación."}
      }
    },
    "gobierno": {
      "nombre": "Gobierno y Política Fiscal",
      "formula_general": "BS = T - G \\quad \\text{donde} \\quad T = T_0 + tY",
      "variables": {
        "G": {"nombre": "Gasto Público (G)", "valor_defecto": 600.0, "ayuda_real": "Compras de bienes y servicios del Estado."},
        "T0": {"nombre": "Impuestos Suma Fija (T0)", "valor_defecto": 200.0, "ayuda_real": "Impuestos independientes de Y."},
        "t": {"nombre": "Tasa Impositiva (t)", "valor_defecto": 0.15, "ayuda_real": "Presión tributaria promedio sobre el PIB."},
        "Y": {"nombre": "Ingreso/PIB (Y)", "valor_defecto": 5000.0, "ayuda_real": "Nivel de producción actual."}
      }
    }
  },
  "estadistica_2": {
    "estimadores": {
      "nombre": "Estimadores Estadísticos y Muestreo",
      "formula_general": "\\bar{x} = \\frac{\\sum x_i}{n} \\quad ; \\quad s^2 = \\frac{\\sum (x_i - \\bar{x})^2}{n-1}",
      "variables": {
        "mu": {"nombre": "Media Poblacional Verdadera (μ)", "valor_defecto": 100.0, "ayuda_real": "El parámetro real y oculto."},
        "sigma": {"nombre": "Desviación Estándar (σ)", "valor_defecto": 15.0, "ayuda_real": "Qué tan dispersos están los datos reales."},
        "n": {"nombre": "Tamaño de la Muestra (n)", "valor_defecto": 30.0, "ayuda_real": "Cuántas observaciones recogemos."}
      }
    },
    "intervalos_muestra": {
      "nombre": "Intervalos de Confianza y Tamaño de Muestra",
      "formula_general": "IC = \\bar{x} \\pm Z \\frac{\\sigma}{\\sqrt{n}} \\quad ; \\quad n = \\left(\\frac{Z \\cdot \\sigma}{E}\\right)^2",
      "variables": {
        "x_bar": {"nombre": "Media Muestral (x̄)", "valor_defecto": 500.0, "ayuda_real": "El promedio que obtuviste en tu muestra inicial."},
        "sigma": {"nombre": "Desviación Estándar (σ)", "valor_defecto": 50.0, "ayuda_real": "La dispersión de los datos."},
        "n_actual": {"nombre": "Muestra Actual (n)", "valor_defecto": 100.0, "ayuda_real": "La cantidad de datos que tienes actualmente."},
        "E": {"nombre": "Margen de Error Deseado (E)", "valor_defecto": 5.0, "ayuda_real": "El error máximo permitido para tu nuevo estudio."}
      }
    },
    "pruebas_hipotesis": {
      "nombre": "Pruebas de Hipótesis (Inferencia)",
      "formula_general": "Z_{calc} = \\frac{\\bar{x} - \\mu_0}{\\sigma / \\sqrt{n}}",
      "variables": {
        "mu_0": {"nombre": "Media Hipotética (μ0)", "valor_defecto": 100.0, "ayuda_real": "El valor hipotético del Status Quo a poner a prueba."},
        "x_bar": {"nombre": "Media Muestral (x̄)", "valor_defecto": 105.0, "ayuda_real": "El promedio real de la muestra obtenida."},
        "sigma": {"nombre": "Desviación Estándar (σ)", "valor_defecto": 15.0, "ayuda_real": "Dispersión poblacional de los datos."},
        "n": {"nombre": "Tamaño de Muestra (n)", "valor_defecto": 50.0, "ayuda_real": "Cantidad de observaciones."},
        "alpha": {"nombre": "Nivel de Significancia (α)", "valor_defecto": 0.05, "ayuda_real": "Riesgo de cometer Error Tipo I."}
      }
    }
  },
