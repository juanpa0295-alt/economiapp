  "estadistica_2": {
    "estimadores": {
      "nombre": "Estimadores Estadísticos y Muestreo",
      "formula_general": "\\bar{x} = \\frac{\\sum x_i}{n} \\quad ; \\quad s^2 = \\frac{\\sum (x_i - \\bar{x})^2}{n-1}",
      "variables": {
        "mu": {
          "nombre": "Media Poblacional Verdadera (μ)",
          "valor_defecto": 100.0,
          "ayuda_real": "El parámetro real y oculto."
        },
        "sigma": {
          "nombre": "Desviación Estándar (σ)",
          "valor_defecto": 15.0,
          "ayuda_real": "Qué tan dispersos están los datos reales."
        },
        "n": {
          "nombre": "Tamaño de la Muestra (n)",
          "valor_defecto": 30.0,
          "ayuda_real": "Cuántas observaciones recogemos."
        }
      }
    },
    "intervalos_muestra": {
      "nombre": "Intervalos de Confianza y Tamaño de Muestra",
      "formula_general": "IC = \\bar{x} \\pm Z \\frac{\\sigma}{\\sqrt{n}} \\quad ; \\quad n = \\left(\\frac{Z \\cdot \\sigma}{E}\\right)^2",
      "variables": {
        "x_bar": {
          "nombre": "Media Muestral (x̄)",
          "valor_defecto": 500.0,
          "ayuda_real": "El promedio que obtuviste en tu muestra inicial."
        },
        "sigma": {
          "nombre": "Desviación Estándar (σ)",
          "valor_defecto": 50.0,
          "ayuda_real": "La dispersión de los datos."
        },
        "n_actual": {
          "nombre": "Muestra Actual (n)",
          "valor_defecto": 100.0,
          "ayuda_real": "La cantidad de datos que tienes actualmente."
        },
        "E": {
          "nombre": "Margen de Error Deseado (E)",
          "valor_defecto": 5.0,
          "ayuda_real": "El error máximo permitido para tu nuevo estudio."
        }
      }
    },
    "pruebas_hipotesis": {
      "nombre": "Pruebas de Hipótesis (Inferencia)",
      "formula_general": "Z_{calc} = \\frac{\\bar{x} - \\mu_0}{\\sigma / \\sqrt{n}}",
      "variables": {
        "mu_0": {
          "nombre": "Media Hipotética (μ0)",
