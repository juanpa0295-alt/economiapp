          "ayuda_real": "El promedio real de la muestra obtenida."
        },
        "sigma": {
          "nombre": "Desviación Estándar (σ)",
          "valor_defecto": 15.0,
          "ayuda_real": "Dispersión poblacional de los datos."
        },
        "n": {
          "nombre": "Tamaño de Muestra (n)",
          "valor_defecto": 50.0,
          "ayuda_real": "Cantidad de observaciones."
        },
        "alpha": {
          "nombre": "Nivel de Significancia (α)",
          "valor_defecto": 0.05,
          "ayuda_real": "Riesgo de cometer Error Tipo I."
        }
      }
    }
